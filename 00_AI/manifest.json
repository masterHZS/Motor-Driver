  "hard_rules": [
    { "id": 1, "rule": "禁止用开环固件带电机；带电机必须 BEMF 闭环", "reason": "2026-10-08 开环带电机剧烈震动事故" },
    { "id": 2, "rule": "带电机必须限流 12.0-16.8V/5A，首转 14.5-15.0V，低油门起步", "reason": "外接 F072 不读 AIN_VBUS/AIN_ISENSE，无软件欠压过流保护" },
    { "id": 3, "rule": "应用固件绝不可驱动 P27/P31", "reason": "板上唯一 SWD 烧录口，锁死后无 nRESET 可恢复" },
    { "id": 4, "rule": "不要把外接 F072 的 3.3V/5V 并到 V3.1 的 VDD_3V3/VBUS；12V 不可接任何 GPIO", "reason": "双电源互灌/器件击穿" },
    { "id": 5, "rule": "改硬件前必读 01_PCB/说明.md 与 01_PCB/Motor-project/V3.1_升级说明.md", "reason": "设计妥协与已验证的返修点" },
    { "id": 6, "rule": "元器件封装必须来自嘉立创官方库（器件选型规范.md R0 白名单）", "reason": "用户硬性要求，check-design.mjs 硬拦截" }
  ],

  "current_chain": {
    "path": "HostSoftware -> USB-TTL/DAPLink（9600-8N1，Modbus-RTU 从站 1）-> 外接 HC32F072JATA（F072_MotorCtrl -Direct/-BEMF）-> TP12-TP17 -> V3.1 FD6288T -> 电机",
    "mapping": [
      { "mcu_pin": "PB2", "testpoint": "TP12", "net": "PWM_AH", "fd6288t": "HIN1" },
      { "mcu_pin": "PA7", "testpoint": "TP13", "net": "PWM_AL", "fd6288t": "LIN1" },

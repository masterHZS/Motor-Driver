      { "mcu_pin": "PB1", "testpoint": "TP17", "net": "PWM_CL", "fd6288t": "LIN3" },
      { "mcu_pin": "GND", "testpoint": "TP2", "net": "AGND", "fd6288t": "COM位于PGND（TP19），AGND经R47连接PGND" }
    ]
  },

  "protocol": {
    "uart": "9600-8N1",
    "modbus_slave_address": 1,
    "function_codes": ["0x03", "0x06"],
    "poll_period_ms": 250,
    "response_timeout_ms": 500,
    "registers": {
      "0x0000": "R  运行状态",
      "0x0001": "R/W 启停请求（写 0 = 六路拉低）",
      "0x0002": "R/W 目标油门0-100（当前F072需另写0x0001=1，不隐式启动）",
      "0x0003": "R/W PWM 频率",
      "0x0004": "R  实际占空比（F072 上限 30%，BEMF 版 15%）",
      "0x0005": "R  故障位 0x0001 非法命令 / 0x0002 通信超时 / 0x0004 BEMF 丢失",
      "0x0006": "R  电换相频率 Hz",
      "0x0007": "R  固件版本（F072 = 0x0100）",
      "0x0008": "R  通信错误计数",
      "0x0009": "R  通信成功计数"
    }
  },

